# MindVerse — Inclusive Learning Lab
# Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.

# Flask Application Settings
FLASK_ENV=development
FLASK_APP=backend/app.py
FLASK_DEBUG=1
SECRET_KEY=change-to-a-secure-random-32-character-secret-in-production

# Server Settings
PORT=5000
HOST=127.0.0.1

# Database Configuration (Relative to backend directory or absolute path)
DATABASE=database/mindverse.db

# CORS Configuration
# Comma-separated list of allowed frontend origins, or single origin
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Caregiver Admin Credentials (Defaults for initial development / seeding)
CAREGIVER_DEFAULT_USER=caregiver
CAREGIVER_DEFAULT_PIN=1234
